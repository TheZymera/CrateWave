{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "cratewave",
    "version":  "0.1.0",
    "identifier":  "com.cratewave.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows": [
                    {
                    "title": "CrateWave",
                    "width": 1650,
                    "height": 930,
                    "resizable": false,
                    "center": true
                    }
                ],
                "security": {
                    "csp": null,
                    "assetProtocol": {
                        "enable": true,
                        "scope": ["$APPCACHE/**", "$AUDIO/**", "$HOME/**"]
                    }
                }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/yt-dlp",
                                       "binaries/ffmpeg",
                                       "binaries/ffprobe"
                                   ]
               }
}